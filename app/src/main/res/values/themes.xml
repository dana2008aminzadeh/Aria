<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aria" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/aria_primary</item>
        <item name="colorOnPrimary">#1A120B</item>
        <item name="colorPrimaryContainer">@color/aria_surface2</item>
        <item name="colorOnPrimaryContainer">@color/aria_primary_dark</item>
        <item name="colorSecondary">@color/aria_accent_blue</item>
        <item name="colorSurface">@color/aria_surface</item>
        <item name="android:statusBarColor">@color/aria_bg</item>
        <item name="android:navigationBarColor">@color/aria_surface</item>
        <item name="android:windowBackground">@color/aria_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="RowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/aria_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <style name="RowSub">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/aria_text_dim</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="DialogMenuAnim">
        <item name="android:windowEnterAnimation">@anim/menu_enter</item>
        <item name="android:windowExitAnimation">@anim/menu_exit</item>
    </style>
</resources>
