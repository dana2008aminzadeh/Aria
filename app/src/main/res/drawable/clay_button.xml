<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#E85D04" android:endColor="#F97316" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#C2410C" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="3dp" android:height="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
