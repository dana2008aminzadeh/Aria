<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aria_surface" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/aria_clay_border" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="3dp" android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
